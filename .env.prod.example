# Example production environment for docker-compose.prod.yml. Copy to .env.prod and replace EVERY value
# marked CHANGE ME before exposing the stack. Secrets must never be committed.
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# CHANGE ME: password must match POSTGRES_PASSWORD in docker-compose.prod.yml (or your managed database).
DATABASE_URL=postgres://system_self:example-db-password@postgres:5432/system_self
# Pool size per process (2 API instances + 1 worker here): keep the total under Postgres max_connections.
DB_POOL_MAX=10

# CHANGE ME: openssl rand -base64 48  (32+ characters; values containing "change-me" are rejected)
JWT_SECRET=REPLACE-with-output-of-openssl-rand-base64-48
# During a rotation only: the old JWT_SECRET (verification only). Remove it 15 minutes after the rotation.
# JWT_SECRET_PREVIOUS=
# CHANGE ME: exact origin(s) of your web client; "*" is not allowed in production.
CORS_ORIGIN=https://app.example.com
# nginx sits in front of the API: trust one proxy hop for client IPs.
TRUST_PROXY=1

# Mail: "log" writes mails to the logs; set RESEND_API_KEY (and remove MAILER) for real delivery.
MAILER=log
# RESEND_API_KEY=re_xxx
MAIL_FROM="SYSTEM // SELF <no-reply@systemself.app>"

# CHANGE ME: openssl rand -base64 32; same value in the RevenueCat dashboard.
REVENUECAT_WEBHOOK_SECRET=REPLACE-with-output-of-openssl-rand-base64-32
# REVENUECAT_API_KEY=sk_xxx
# EXPO_ACCESS_TOKEN=
# GEMINI_API_KEY=

WORKER_TICK_MS=60000
