{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.0.10:8080"
      },
      "node": "22.20.0"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging-api.systemself.app"
      },
      "node": "22.20.0"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.systemself.app"
      },
      "node": "22.20.0"
    },
    "share": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://phantom.tailabe292.ts.net"
      },
      "node": "22.20.0"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "PLACEHOLDER_H03",
        "ascAppId": "PLACEHOLDER_H03"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
