# Full origin of the API server, reachable from the phone (scheme included).
# A phone cannot reach "localhost" on your machine: use the machine's LAN IP, e.g. http://192.168.1.12:3001
# In dev, if unset, the app derives http://<metro host>:3001, which is usually what you want.
# EXPO_PUBLIC_API_URL=http://192.168.1.12:3001

# RevenueCat public SDK keys (store builds only; without them, or in Expo Go, the paywall shows fallback prices and no purchase)
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
