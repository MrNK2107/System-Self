  "components": [
    {
      "name": "Filled Button",
      "kind": "button",
      "refersTo": "button-filled",
      "description": "The one primary action in a block; often full width.",
      "html": "<button class=\"ds-btn-filled\">START</button>",
      "css": ".ds-btn-filled{background:#A879FF;color:#0B0812;font:500 12px/16px 'Chakra Petch',sans-serif;letter-spacing:1.2px;text-transform:uppercase;min-height:48px;padding:0 24px;border:none;border-radius:4px;cursor:pointer;transition:filter .15s}.ds-btn-filled:hover{filter:brightness(1.06)}.ds-btn-filled:active{filter:brightness(.82)}.ds-btn-filled:focus-visible{outline:2px solid #B48CFF;outline-offset:2px}"
    },
    {
      "name": "Tonal Button",
      "kind": "button",
      "refersTo": "button-tonal",
      "description": "Secondary action that still needs a body.",
      "html": "<button class=\"ds-btn-tonal\">DETAILS</button>",
      "css": ".ds-btn-tonal{background:#1C1726;color:#B48CFF;font:500 12px/16px 'Chakra Petch',sans-serif;letter-spacing:1.2px;text-transform:uppercase;min-height:48px;padding:0 24px;border:none;border-radius:4px;cursor:pointer}.ds-btn-tonal:hover,.ds-btn-tonal:active{background:#2A2340}.ds-btn-tonal:focus-visible{outline:2px solid #B48CFF;outline-offset:2px}"
    },
    {
      "name": "Text Button",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Quiet secondary action under a primary.",
      "html": "<button class=\"ds-btn-text\">MARK COMPLETE</button>",
      "css": ".ds-btn-text{background:transparent;color:#B48CFF;font:500 12px/16px 'Chakra Petch',sans-serif;letter-spacing:1.2px;text-transform:uppercase;min-height:48px;padding:0 12px;border:none;border-radius:4px;cursor:pointer}.ds-btn-text:hover,.ds-btn-text:active{background:rgba(168,121,255,.18)}.ds-btn-text:focus-visible{outline:2px solid #B48CFF;outline-offset:2px}"
    },
    {
      "name": "Segmented Control",
      "kind": "chip",
      "refersTo": "segmented-selected",
      "description": "One choice among sections (Arena: Rivals / Clan / Challenges).",
      "html": "<div class=\"ds-seg\" role=\"tablist\"><button class=\"ds-seg-item on\">RIVALS</button><button class=\"ds-seg-item\">CLAN</button><button class=\"ds-seg-item\">CHALLENGES</button></div>",
      "css": ".ds-seg{display:flex;border:1px solid #2A2340;border-radius:4px;overflow:hidden;background:#07060B;width:360px}.ds-seg-item{flex:1;min-height:48px;background:transparent;border:none;color:#B5ACC4;font:500 12px/16px 'Chakra Petch',sans-serif;letter-spacing:1.2px;cursor:pointer}.ds-seg-item:hover{background:rgba(168,121,255,.16)}.ds-seg-item.on{background:#A879FF;color:#0B0812}.ds-seg-item:focus-visible{outline:2px solid #B48CFF;outline-offset:-2px}"
    },
    {
      "name": "System Window",
      "kind": "card",
      "refersTo": "system-window",
      "description": "THE SYSTEM's voice only: translucent violet panel, 1px notched frame, bracketed title bar, typed line.",
      "html": "<div class=\"ds-window\"><div class=\"ds-window-title\">[ MORNING BRIEFING ]</div><p class=\"ds-window-line\">Day 1. Rank E. Trajectory flat. Open your quests.<span class=\"ds-caret\"></span></p></div>",
      "css": ".ds-window{position:relative;width:340px;padding:0 16px 16px;color:#F1ECF7;background:rgba(176,140,255,.55);clip-path:polygon(10px 0,calc(100% - 10px) 0,100% 10px,100% calc(100% - 10px),calc(100% - 10px) 100%,10px 100%,0 calc(100% - 10px),0 10px)}.ds-window::after{content:'';position:absolute;inset:1px;background:#1A1430;clip-path:polygon(9.6px 0,calc(100% - 9.6px) 0,100% 9.6px,100% calc(100% - 9.6px),calc(100% - 9.6px) 100%,9.6px 100%,0 calc(100% - 9.6px),0 9.6px);z-index:0}.ds-window>*{position:relative;z-index:1}.ds-window-title{margin:0 -16px 4px;padding:12px 0;text-align:center;border-bottom:1px solid rgba(176,140,255,.55);color:#B48CFF;font:500 12px/16px 'Chakra Petch',sans-serif;letter-spacing:1.2px}.ds-window-line{margin:8px 0 0;font:600 20px/28px 'Chakra Petch',sans-serif}.ds-caret{display:inline-block;width:10px;height:20px;background:#A879FF;vertical-align:-3px;margin-left:2px}"
    },
    {
      "name": "System Echo",
      "kind": "custom",
      "refersTo": "system-window-solid",
      "description": "Solid window above the tab bar answering a completed quest with the server-applied amount.",
      "html": "<div class=\"ds-echo\"><div class=\"ds-echo-title\">[ QUEST COMPLETE ]</div><div class=\"ds-echo-line\">+3.3 DISCIPLINE. Logged.</div></div>",
      "css": ".ds-echo{width:340px;background:#1A1430;border:1px solid rgba(176,140,255,.55);color:#F1ECF7;animation:ds-rise .28s cubic-bezier(.33,1,.68,1)}.ds-echo-title{padding:12px 0;text-align:center;border-bottom:1px solid rgba(176,140,255,.55);color:#B48CFF;font:500 12px/16px 'Chakra Petch',sans-serif;letter-spacing:1.2px}.ds-echo-line{padding:16px;text-align:center;font:600 20px/26px 'Chakra Petch',sans-serif;font-variant-numeric:tabular-nums}@keyframes ds-rise{from{transform:translateY(32px);opacity:0}to{transform:none;opacity:1}}@media (prefers-reduced-motion:reduce){.ds-echo{animation:none}}"
    },
    {
      "name": "Quest Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Solid card for the user's own data: domain mark, title, the display reward, deadline, one filled action.",
      "html": "<div class=\"ds-card\"><div class=\"ds-card-top\"><span class=\"ds-dom\"><i></i>BODY</span><span class=\"ds-meta\">Daily</span></div><div class=\"ds-card-title\">Home session</div><div class=\"ds-reward\">+3<span>BODY</span></div><div class=\"ds-due\">Due 00:00 · 1h left</div><button class=\"ds-card-btn\">START</button></div>",
      "css": ".ds-card{width:340px;background:#120F1A;border:1px solid #2A2340;border-radius:4px;padding:16px;display:flex;flex-direction:column;gap:8px;color:#F1ECF7}.ds-card-top{display:flex;justify-content:space-between;align-items:center}.ds-dom{display:flex;align-items:center;gap:8px;color:#E8604C;font:500 12px/16px 'Chakra Petch',sans-serif;letter-spacing:1.2px}.ds-dom i{width:8px;height:8px;border-radius:4px;background:#E8604C}.ds-meta{color:#8E85A0;font:400 12px/16px 'Noto Sans',sans-serif}.ds-card-title{font:600 20px/28px 'Chakra Petch',sans-serif}.ds-reward{display:flex;align-items:flex-end;gap:8px;font:700 56px/60px 'Chakra Petch',sans-serif}.ds-reward span{color:#E8604C;font:500 12px/16px 'Chakra Petch',sans-serif;letter-spacing:1.2px;margin-bottom:10px}.ds-due{color:#F2B544;font:400 12px/16px 'Noto Sans',sans-serif}.ds-card-btn{margin-top:8px;min-height:48px;background:#A879FF;color:#0B0812;border:none;border-radius:4px;font:500 12px/16px 'Chakra Petch',sans-serif;letter-spacing:1.2px;cursor:pointer}.ds-card-btn:hover{filter:brightness(1.06)}.ds-card-btn:focus-visible{outline:2px solid #B48CFF;outline-offset:2px}"
    },
    {
      "name": "List Row",
      "kind": "custom",
      "refersTo": "list-row",
      "description": "64dp row with domain dot, body title, meta subtitle, trailing value and chevron.",
      "html": "<div class=\"ds-row\" tabindex=\"0\"><i class=\"ds-row-dot\"></i><div class=\"ds-row-text\"><div>Deep work session</div><small>MIND · done</small></div><span class=\"ds-row-val\">20.0</span><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#8E85A0\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"9 18 15 12 9 6\"/></svg></div>",
      "css": ".ds-row{width:340px;min-height:64px;display:flex;align-items:center;gap:16px;padding:12px 16px;border-bottom:1px solid #2A2340;background:#07060B;color:#F1ECF7;cursor:pointer}.ds-row:hover,.ds-row:active{background:rgba(168,121,255,.12)}.ds-row:focus-visible{outline:2px solid #B48CFF;outline-offset:-2px}.ds-row-dot{width:8px;height:8px;border-radius:4px;background:#4F8FE0}.ds-row-text{flex:1;font:400 15px/22px 'Noto Sans',sans-serif}.ds-row-text small{display:block;color:#B5ACC4;font:400 12px/16px 'Noto Sans',sans-serif}.ds-row-val{font:600 20px/26px 'Chakra Petch',sans-serif;font-variant-numeric:tabular-nums}"
    },
