{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/dev.ts",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "worker": "node --enable-source-maps ./dist/worker.mjs",
    "dev:worker": "tsx src/dev-worker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "admin:grant": "tsx src/scripts/grant-admin.ts",
    "test": "tsx --import ./src/test-setup.ts --test --test-concurrency=1 \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@node-rs/argon2": "^2.2.2",
    "@workspace/api-zod": "workspace:*",
    "@workspace/contracts": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/engine": "workspace:*",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.12",
    "pino": "^9",
    "pino-http": "^10",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "supertest": "^7.3.1",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
