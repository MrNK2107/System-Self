# Every variable below is parsed in src/lib/env.ts. Values shown are safe for local development.

# Runtime: development | test | production. Leaving it unset is treated as production-like:
# JWT_SECRET and RESEND_API_KEY (or MAILER=log) become mandatory.
NODE_ENV=development
# HTTP port (1-65535)
PORT=3001
# Pino log level. Defaults to "silent" when NODE_ENV=test, "info" otherwise.
LOG_LEVEL=info

# Postgres connection string. Optional: when unset the API runs with db=null and DB endpoints return 503.
# Matches `docker compose up -d postgres` from the repo root.
DATABASE_URL=postgres://system_self:system_self@localhost:5432/system_self
# Max connections of each process's Postgres pool (default 10).
# DB_POOL_MAX=10

# Auth
# HS256 signing secret, minimum 32 chars. A built-in dev default is used only when NODE_ENV is
# explicitly development or test. Otherwise startup fails unless a real value is set; values containing
# "change-me" (like the placeholder below) are always rejected outside development/test.
# Generate: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-at-least-32-characters
# Secret being rotated out (verification only; new tokens are signed with JWT_SECRET). Remove it one access-token
# lifetime after the rotation. Same rules as JWT_SECRET outside development/test.
# JWT_SECRET_PREVIOUS=
# Access token lifetime in seconds
ACCESS_TOKEN_TTL_SEC=900
# Refresh token lifetime in days (tokens rotate on every refresh)
REFRESH_TOKEN_TTL_DAYS=30

# Rollover worker (`pnpm worker`): milliseconds between ticks (min 1000)
WORKER_TICK_MS=60000
# Wall-clock budget (ms) of one social job pass; the rest of its backlog waits for the next tick.
SOCIAL_JOB_BUDGET_MS=2000
# Wall-clock budget (ms) of the push decide phase; undecided users wait for the next tick.
PUSH_JOB_BUDGET_MS=15000
# Wall-clock budget (ms) of the push send phase, timed from its own start; each Expo request also times out after 10 s.
PUSH_SEND_BUDGET_MS=15000

# Email (verification and password reset codes). Required outside development/test unless MAILER=log is set.
# Without a key (or with MAILER=log) a log mailer writes mails to the logs; 6-digit codes are redacted
# unless NODE_ENV is development or test.
# RESEND_API_KEY=re_xxx
# MAILER=log
MAIL_FROM="SYSTEM // SELF <no-reply@systemself.app>"

# AI (Gemini). Optional: without a key, or when Gemini fails, the API serves template output with model "template".
# GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# Retries per model for retryable errors (0-5) and base backoff in ms (min 50, doubles per retry)
GEMINI_RETRY_COUNT=2
GEMINI_RETRY_BASE_MS=250

# HTTP hardening
# Comma-separated origin allowlist. Required (and "*" refused) outside development/test; unlisted Origins get 403,
# requests without an Origin header (native apps) pass. Unset means "*" (development only).
CORS_ORIGIN=http://localhost:8081,http://localhost:19006
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
# Reverse proxy hops to trust for client IPs (X-Forwarded-For): unset/false (direct), a hop count like 1, or true.
# Set it to the number of proxies in front of the API, or every client shares one rate-limit bucket.
# TRUST_PROXY=1

# Billing (RevenueCat). The webhook (POST /api/billing/revenuecat) expects `Authorization: Bearer <this secret>`.
# Unset: the endpoint answers 503 and never accepts events. Set the same value in the RevenueCat dashboard.
# Generate: openssl rand -base64 32
# REVENUECAT_WEBHOOK_SECRET=
# RevenueCat secret REST API key (v1, sk_...). Needed to apply TRANSFER events (a restore moving a subscription to
# another account): both accounts are re-fetched from RevenueCat. Unset: transfers are logged and change nothing.
# REVENUECAT_API_KEY=

# Push notifications (Expo Push API). Optional: only needed when "Enhanced Push Security" is enabled for the Expo project.
# EXPO_ACCESS_TOKEN=your_expo_access_token
