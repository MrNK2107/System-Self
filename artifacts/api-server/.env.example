NODE_ENV=development
PORT=3001

# Required
GEMINI_API_KEY=your_gemini_api_key

# Database
DATABASE_URL=postgres://user:password@localhost:5432/system_self

# AI model config
GEMINI_MODEL=gemini-1.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash-8b
GEMINI_RETRY_COUNT=2
GEMINI_RETRY_BASE_MS=250

# Security / API behavior
CORS_ORIGIN=http://localhost:8081,http://localhost:19006
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
LOG_LEVEL=info

# Auth: format token:username pairs, comma-separated
# Example: API_AUTH_TOKENS=dev-token-1:nanda,dev-token-2:alex
AUTH_ENABLED=true
API_AUTH_TOKENS=dev-token:nanda
