NODE_ENV=development
PORT=3001

# Required
GEMINI_API_KEY=your_gemini_api_key

# Database
DATABASE_URL=postgres://user:password@localhost:5432/system_self

# AI model config
GEMINI_MODEL=gemini-1.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash-8b
GEMINI_RETRY_COUNT=2
GEMINI_RETRY_BASE_MS=250

# Security / API behavior
CORS_ORIGIN=http://localhost:8081,http://localhost:19006
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
LOG_LEVEL=info

# Auth
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# Email (log mailer is used when RESEND_API_KEY is unset)
# RESEND_API_KEY=re_xxx
MAIL_FROM="SYSTEM // SELF <no-reply@systemself.app>"
